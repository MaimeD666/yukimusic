{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yukicloud",
  "version": "0.2.0",
  "identifier": "dev.maimed.yukicloud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yukicloud",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#12131c",
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.sndcdn.com; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/ffmpeg.exe", "resources/THIRD-PARTY.txt", "resources/FFmpeg-LGPLv2.1.txt"],
    "shortDescription": "Музыка в одном пространстве",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
